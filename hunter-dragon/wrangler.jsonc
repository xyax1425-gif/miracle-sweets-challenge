{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "miracle-hunter-dragon-challenge",
  "main": "worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUNTER_DRAGON_TICKET_STORE",
        "class_name": "HunterDragonTicketStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HunterDragonTicketStore"]
    }
  ]
}
